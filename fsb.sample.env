# ===== fsb-stream (streaming / serving service) =====
API_ID=
API_HASH=
# MUST be the same BOT_TOKEN as the bot repo (user-owned channels are read by this bot)
BOT_TOKEN=
# Owner/shared storage channel — same value as in the bot repo
LOG_CHANNEL=
# Same MongoDB as the bot repo (required)
DATABASE_URL=
# Same secret as the bot repo. If empty, BOT_TOKEN is used.
HASH_SECRET=

# Public URL of THIS service (used in logs / health). The bot repo's STREAM_HOST must point here.
HOST=https://stream.example.com
PORT=8080
HASH_LENGTH=16
DEV=false

# Shown on the expired / error pages
BOT_NAME=File to Link
UPDATES_CHANNEL=

# Optional: extra worker bots to spread load for the OWNER channel
# (add them as admins of LOG_CHANNEL, or set USER_SESSION to auto-add them)
# MULTI_TOKEN1=
# USER_SESSION=

STREAM_CONCURRENCY=4
STREAM_BUFFER_COUNT=8
STREAM_TIMEOUT_SEC=30
STREAM_MAX_RETRIES=3
